# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# Empty locally. Behind a load balancer set to the proxy's address range, e.g. "loopback,uniquelocal" or a CIDR.
TRUST_PROXY=
BODY_LIMIT=10kb
# Comma-separated origins; empty disables CORS.
CORS_ORIGINS=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener

REDIS_URL=redis://localhost:6379

# Short codes
SHORT_CODE_LENGTH=7
SHORT_CODE_MAX_ATTEMPTS=5

# URL validation
MAX_URL_LENGTH=2048
MAX_EXPIRY_DAYS=3650

# Cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_NEGATIVE_TTL_SECONDS=60
CACHE_COMMAND_TIMEOUT_MS=50
CACHE_BREAKER_FAILURE_THRESHOLD=5
CACHE_BREAKER_RESET_MS=10000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_MODE=closed
RATE_LIMIT_CREATE_MAX=10
RATE_LIMIT_CREATE_WINDOW_SECONDS=60
RATE_LIMIT_DELETE_MAX=10
RATE_LIMIT_DELETE_WINDOW_SECONDS=60
RATE_LIMIT_INFO_MAX=60
RATE_LIMIT_INFO_WINDOW_SECONDS=60
# Redis round-trip budget for one rate-limit check; exceeding it counts as "unavailable".
RATE_LIMIT_COMMAND_TIMEOUT_MS=100

# Queues
BULLMQ_ANALYTICS_QUEUE=url-analytics
BULLMQ_CLEANUP_QUEUE=url-cleanup
JOB_TIMEOUT_MS=10000
ANALYTICS_WORKER_CONCURRENCY=10
# Enqueueing is fire-and-forget from the redirect; this bounds how long a pending enqueue may live.
ANALYTICS_ENQUEUE_TIMEOUT_MS=500
CLEANUP_CRON=*/15 * * * *
CLEANUP_BATCH_SIZE=1000
ANALYTICS_RETENTION_DAYS=90
WORKER_HEALTH_PORT=3001

# Privacy. Required (>= 32 chars) in production. Generate with: openssl rand -hex 32
IP_HASH_SECRET=dev-only-secret-change-me-please-0000

# Shutdown
# Must be at least JOB_TIMEOUT_MS + 3000 and below the container stop grace period (30s).
SHUTDOWN_TIMEOUT_MS=20000

# Observability
LOG_LEVEL=info
METRICS_ENABLED=true
